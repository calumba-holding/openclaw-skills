{
  "gitlab": {
    "host": "gitlab.intchains.in:9000",
    "projectId": "514",
    "defaultBaseBranch": "main",
    "token": "${GITLAB_TOKEN}"
  },
  "review": {
    "repoPath": "~/reviews/myproject",
    "language": "zh",
    "severityThreshold": "high",
    "aiMaxFiles": 5,
    "aiMaxDiffLines": 300,
    "scope": "full_file"
  },
  "notifications": {
    "feishuWebhookUrl": "${FEISHU_WEBHOOK_URL}"
  },
  "openclaw": {
    "gatewayUrl": "http://127.0.0.1:18789",
    "hookPath": "/webhooks/gitlab",
    "hookToken": "${OPENCLAW_HOOK_TOKEN}",
    "gitlabWebhookSecret": "${GITLAB_WEBHOOK_SECRET}"
  },
  "webhookListener": {
    "port": 18800,
    "listenPath": "/webhook",
    "healthPath": "/health",
    "maxPayloadBytes": 5242880,
    "enableMergeRequestEvents": true,
    "enablePushEvents": true,
    "mrTriggerActions": ["open", "reopen", "update"],
    "mrRequiredState": "opened",
    "mrSkipTitleTags": ["[skip-review]"],
    "pushReviewBranches": ["main", "master", "develop", "dev"],
    "openclawSenderName": "GitLab",
    "openclawWakeMode": "now",
    "openclawDeliver": true,
    "openclawChannel": "last",
    "openclawTimeoutSec": 30
  }
}
